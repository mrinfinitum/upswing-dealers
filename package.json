{
  "name": "upswing-dealers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "npm run test:dropbox && npm run test:admin && npm run test:portal && npm run test:phase2",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "qa:responsive": "node scripts/qa-responsive.mjs",
    "audit:enrichment": "tsx scripts/generate-enrichment-audit.ts",
    "audit:coordinates": "tsx scripts/generate-coordinate-audit.ts",
    "geocode:input": "tsx scripts/export-browser-geocode-input.ts",
    "scan:credentials": "node --env-file-if-exists=.env.local scripts/scan-client-credentials.mjs",
    "test:phase2": "tsx scripts/test-phase2.ts",
    "test:admin": "tsx scripts/test-admin-data.ts",
    "test:portal": "tsx scripts/test-dealer-portal.ts",
    "test:dropbox": "tsx scripts/test-dropbox.ts",
    "supabase:import": "tsx --env-file=.env.local scripts/import-dealers-to-supabase.ts",
    "dealers:reconcile": "tsx --env-file=.env.local scripts/reconcile-master-dealers.ts",
    "dealers:import-master": "tsx --env-file=.env.local scripts/import-master-independent-dealers.ts",
    "dealers:publish-reviewed": "tsx --env-file=.env.local scripts/publish-reviewed-independent-dealers.ts",
    "dealers:publish-manual": "tsx --env-file=.env.local scripts/publish-manually-supplied-dealers.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.65.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
