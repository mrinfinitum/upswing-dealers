# Public origin used for absolute social metadata.
NEXT_PUBLIC_SITE_URL=https://dealers.upswinggolf.com

# Google Maps browser configuration. This key is intentionally client-visible and
# MUST have Website/referrer restrictions plus Maps JavaScript API and Geocoding
# API restrictions before use. Never use a server/web-service key here.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Supabase public configuration (safe for browser use; RLS remains mandatory).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by the explicit import workflow and by authenticated admin
# actions that invite/manage dealer portal users. Never prefix with NEXT_PUBLIC_,
# expose it to browser code, log it, or reuse it as a public key.
# SUPABASE_SERVICE_ROLE_KEY=

# Dropbox image gallery (all values are server-only).
# Required read-only scopes: account_info.read, files.metadata.read,
# and files.content.read. Never prefix any Dropbox setting with NEXT_PUBLIC_.
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REDIRECT_URI=https://dealers.upswinggolf.com/api/dropbox/callback
# DROPBOX_REFRESH_TOKEN=
# DROPBOX_GALLERY_PATH=
# Enable only during the one-time admin OAuth bootstrap, then remove or set false.
# DROPBOX_OAUTH_BOOTSTRAP_ENABLED=false

# Cloudflare Turnstile for the public /become-a-dealer form. Uses the shared
# "UpSwing Golf site forms" widget; the site key below is the production default.
# TURNSTILE_SECRET_KEY is server-only and required in production (the form refuses
# submissions without it). Outside production, Cloudflare's always-pass test keys are used.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFivclYk3k3GRhKl
# TURNSTILE_SECRET_KEY=

# Resend email (server-only): dealer application notifications and self-service
# password reset links. Use a sending-only key restricted to the verified
# send.upswinggolf.com domain. Without it, neither email is sent.
# RESEND_API_KEY=
# DEALER_APPLICATION_EMAIL_TO=info@upswinggolf.com
# DEALER_PORTAL_EMAIL_FROM=UpSwing Dealer Portal <dealers@send.upswinggolf.com>
